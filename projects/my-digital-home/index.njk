  <section class="pp-text-image">
    <div class="pp-text-image-left">
      <div style="height: 2vw"></div>
      <p class="pp-body">I deduced what's needed:</p>
      <p class="pp-body">1. screen<br>2. tactile controls<br>3. keyboard<br>4. camera<br>5. portability</p>
